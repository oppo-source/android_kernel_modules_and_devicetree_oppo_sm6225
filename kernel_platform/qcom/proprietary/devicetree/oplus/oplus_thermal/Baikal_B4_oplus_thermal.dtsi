&pm6125_vadc {
	pinctrl-0 =  <&bb_ufs_therm_default>;

	bb_ufs_therm {
		reg = <ADC5_GPIO4_100K_PU>;
		label = "bb_ufs_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};

};

&pm6125_gpios {
	bb_ufs_therm {
		bb_ufs_therm_default: bb_ufs_therm_default {
			pins = "gpio7";
			bias-high-impedance;
		};
	};
};

&pm6125_adc_tm_iio{
	bb_ufs_therm {
		reg = <2>;
		io-channels = <&pm6125_vadc ADC5_GPIO4_100K_PU>;
	};
};

&thermal_zones {
	bb-ufs-therm {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&pm6125_adc_tm_iio 2>;
		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};
};

&tlmm {
	tlmm_ntc_pins: tlmm_ntc_pins {
		ntc_switch_flash_led: ntc_switch_flash_led {
			mux {
				pins = "gpio85";
				function = "gpio";
			};

			config {
				pins = "gpio85";
				drive-strength = <2>;
				output-high;
			};
		};

		ntc_switch_usbtemp_r: ntc_switch_usbtemp_r {
			mux {
				pins = "gpio85";
				function = "gpio";
			};

			config {
				pins = "gpio85";
				drive-strength = <2>;
				output-low;
			};
		};
	};
};


&soc {
	flash_led {
		compatible = "oplus,flash-led-temp";
		pinctrl-names = "ntc_switch_flash_led", "ntc_switch_usbtemp_r";
		pinctrl-0 = <&ntc_switch_flash_led>;
		pinctrl-1 = <&ntc_switch_usbtemp_r>;

		io-channels = <&pm6125_vadc ADC5_GPIO1_100K_PU>;
		io-channel-names = "flash_led_temp_adc";
	};
};
