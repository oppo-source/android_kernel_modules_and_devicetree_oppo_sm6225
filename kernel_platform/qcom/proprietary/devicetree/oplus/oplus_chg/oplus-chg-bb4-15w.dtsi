#include <dt-bindings/iio/qti_power_supply_iio.h>
#include "oplus-chg-6225.h.dtsi"

&thermal_zones {
	soc {
		thermal_soc_cooling_maps: cooling-maps {
			soc_cpu0 {
				cooling-device =
					<&CPU0 (THERMAL_MAX_LIMIT-4)
						(THERMAL_MAX_LIMIT-4)>;
			};

			soc_cpu4 {
				cooling-device =
					<&CPU4 (THERMAL_MAX_LIMIT-4)
						(THERMAL_MAX_LIMIT-4)>;
			};
		};
	};
};

&soc {
	oplus_pd_manager: oplus,pd_manager{
		compatible = "oplus,hal-pd-manager";
		oplus,ic_type = <OPLUS_CHG_IC_TYPEC>;
		oplus,ic_index = <0>;
		oplus,enable_tcpc_irq;
	};
};

&usb0 {
	dpdm-supply = <&usb2_phy0>;
	extcon = <&oplus_pd_manager>;
	#io-channel-cells = <1>;
	dwc3@4e00000 {
		dr_mode = "otg";
	};
};

&usb2_phy0 {
	qcom,param-override-seq =
		<0x67 0x6c	/* override_x0 */
		 0x87 0x70	/* override_x1 */
		 0x2e 0x74	/* override x2 */
		 0x03 0x78>;	/* override x3 */
	qcom,param-override-seq-host =
		<0x67 0x6c	/* override_x0 */
		 0xcd 0x70	/* override_x1 */
		 0x2e 0x74	/* override x2 */
		 0x03 0x78>;	/* override x3 */
};

&qupv3_se4_2uart_pins{
	qupv3_se4_2uart_active: qupv3_se4_2uart_active {
		mux {
			pins = "gpio12", "gpio13";
			function = "qup4";
		};

		config {
			pins = "gpio12", "gpio13";
			drive-strength = <2>;
			bias-disable;
		};
	};

	qupv3_se4_2uart_sleep_backup: qupv3_se4_2uart_sleep_backup {
		mux {
			pins = "gpio12", "gpio13";
			function = "gpio";
		};

		config {
			pins = "gpio12", "gpio13";
			drive-strength = <2>;
			bias-disable;
			input-enable;
		};
	};
};

&qupv3_se4_2uart {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&qupv3_se4_2uart_active>;
	pinctrl-1 = <&qupv3_se4_2uart_sleep_backup>;
	status = "ok";
};

&tlmm {
	tlmm_chg_pins: tlmm_chg_pins {
		vib_on_high: vib_on_high {
			mux {
				pins = "gpio100";
				function = "gpio";
			};

			config {
				pins = "gpio100";
				drive-strength = <2>;
				output-high;
			};
		};
		vib_off_low: vib_off_low {
			mux {
				pins = "gpio100";
				function = "gpio";
			};

			config {
				pins = "gpio100";
				drive-strength = <2>;
				output-low;
			};
		};
		rt1711h_int_n: rt1711h_int_n {
			mux {
				pins = "gpio89";
				function = "gpio";
			};

			config {
				pins = "gpio89";
				drive-strength = <2>;
				bias-disable;
			};
		};

		qupv3_se0_i2c_sleep: qupv3_se0_i2c_sleep {
				mux {
					pins = "gpio0", "gpio1";
					function = "gpio";
				};

				config {
					pins = "gpio0", "gpio1";
					drive-strength = <2>;
					bias-no-pull;
					output-high;
				};
		};

		charging_inter_active: charging_inter_active {
				mux {
				pins = "gpio32";
				function = "gpio";
			};

			config {
				pins = "gpio32";
				drive-strength = <2>;
				bias-pull-up;
			};
		};

		charging_inter_sleep: charging_inter_sleep {
			mux {
				pins = "gpio32";
				function = "gpio";
			};

			config {
				pins = "gpio32";
				drive-strength = <2>;
				bias-pull-up;
			};
		};

		batt_id2_active: batt_id2_active {
				mux {
				pins = "gpio97";
				function = "gpio";
			};

			config {
				pins = "gpio97";
				drive-strength = <2>;
				bias-pull-up;
			};
		};

		batt_id2_sleep: batt_id2__sleep {
			mux {
				pins = "gpio97";
				function = "gpio";
			};

			config {
				pins = "gpio97";
				drive-strength = <2>;
				bias-pull-up;
			};
		};

		ntc_switch2_high: ntc_switch2_high {
			mux {
				pins = "gpio101";
				function = "gpio";
			};

			config {
				pins = "gpio101";
				drive-strength = <2>;
				output-high;
			};
		};

		ntc_switch2_low: ntc_switch2_low {
			mux {
				pins = "gpio101";
				function = "gpio";
			};

			config {
				pins = "gpio101";
				drive-strength = <2>;
				output-low;
			};
		};

	};
};

&pm6125_vadc {
	compatible = "qcom,spmi-adc5-usbtemp-to-volt";
	pinctrl-0 = <&usbtemp_r_v_chan_default &usbtemp_l_v_chan_default &batt_id_chan_default>;
	usbtemp_r_v_chan {
		reg = <ADC5_GPIO1_100K_PU>;
		label = "usbtemp_r_v_chan";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		qcom,scale-fn-type = <ADC_SCALE_HW_CALIB_DEFAULT>;
	};

	usbtemp_l_v_chan {
		reg = <ADC5_GPIO2_100K_PU>;
		label = "usbtemp_l_v_chan";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		qcom,scale-fn-type = <ADC_SCALE_HW_CALIB_DEFAULT>;
	};

	batt_id_chan {
		reg = <ADC5_GPIO3_100K_PU>;
		label = "batt_id_chan";
		qcom,scale-fn-type = <ADC_SCALE_HW_CALIB_DEFAULT>;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};
};

&pm6125_gpios {
	pm6125_chg_pins: pm6125_chg_pins {
		usbtemp_r_v_chan {
			usbtemp_r_v_chan_default: usbtemp_r_v_chan_default {
				pins = "gpio3";
				bias-high-impedance;
			};
		};

		usbtemp_l_v_chan {
			usbtemp_l_v_chan_default: usbtemp_l_v_chan_default {
				pins = "gpio4";
				bias-high-impedance;
			};
		};

		batt_id_chan {
			batt_id_chan_default: batt_id_chan_default {
				pins = "gpio6";
				bias-high-impedance;
			};
		};

	};
	dischg_enable: dischg_enable {
		pins = "gpio8";
		function = "normal";
		power-source = <0>;
		output-high;
		input-disable;
		qcom,drive-strength = <2>;
	};

	dischg_disable: dischg_disable {
		pins = "gpio8";
		function = "normal";
		power-source = <0>;
		output-low;
		input-disable;
		qcom,drive-strength = <2>;
	};
};

&qupv3_se1_i2c_pins {
	qupv3_se1_i2c_sleep: qupv3_se1_i2c_sleep {
		mux {
			pins = "gpio4", "gpio5";
			function = "gpio";
		};

		config {
			pins = "gpio4", "gpio5";
			drive-strength = <2>;
			bias-no-pull;
			output-high;
		};
	};
	qupv3_se1_i2c_pulldown: qupv3_se1_i2c_pulldown {
		mux {
			pins = "gpio4", "gpio5";
			function = "gpio";
		};

		config {
			pins = "gpio4", "gpio5";
			drive-strength = <2>;
			bias-pull-down;
			output-low;
		};
	};

	qupv3_se1_i2c_pullup: qupv3_se1_i2c_pullup {
		mux {
			pins = "gpio4", "gpio5";
			function = "gpio";
		};

		config {
			pins = "gpio4", "gpio5";
			drive-strength = <2>;
			bias-pull-up;
			input-enable;
		};
	};
};

&qupv3_se1_i2c {
	status = "okay";
	qcom,clk-freq-out = <400000>;
	pinctrl-names = "default", "sleep", "pulldown", "pullup";
	pinctrl-0 = <&qupv3_se1_i2c_active>;
	pinctrl-1 = <&qupv3_se1_i2c_sleep>;
	pinctrl-2 = <&qupv3_se1_i2c_pulldown>;
	pinctrl-3 = <&qupv3_se1_i2c_pullup>;
	oplus_ext_gauge:cw2217@64 {
		status = "okay";
		compatible = "cellwise,cw2217";
		reg = <0x64>;
		oplus,ic_index = <0>;
		oplus,ic_type = <OPLUS_CHG_IC_GAUGE>;
		qcom,cw_ui_full = <100>;
		qcom,cw_user_rsense = <5000>;
		qcom,cw_switch_config_profile;
		oplus,batt_num = <1>;
		qcom,design_capacity = <6100>;
		qcom,rated_capacity = <6100>;
		io-channels = <&pm6125_vadc ADC5_GPIO3_100K_PU>;
		io-channel-names = "batt_id_chan";
		dep-supply = <&pm6125_vadc>;
		oplus,batt_id2_gpio = <&tlmm 97 0x0>;
		pinctrl-names = "batt_id2_active", "batt_id2_sleep", "ntc_switch2_high", "ntc_switch2_low";
		pinctrl-0 = <&batt_id2_active>;
		pinctrl-1 = <&batt_id2_sleep>;
		pinctrl-2 = <&ntc_switch2_high>;
		pinctrl-3 = <&ntc_switch2_low>;
		batid_voltage_range = <70 180>;

		qcom,config_profile_data0 = /bits/ 8 <
			0x46 0x00 0x00 0x00 0x00 0x00 0x00 0x00
			0xA3 0xBE 0xBC 0xC2 0xAC 0xA3 0xD6 0xC3
			0xB2 0xF6 0xD2 0x9C 0x81 0x61 0x51 0x44
			0x3A 0x32 0x29 0x98 0x94 0xDF 0xD1 0xFF
			0xDB 0xD4 0xD7 0xD6 0xD2 0xD1 0xCE 0xCA
			0xC4 0xC3 0xD0 0xBE 0x9A 0x8F 0x84 0x75
			0x65 0x62 0x7C 0x8C 0x9D 0xA7 0x6F 0x62
			0x20 0x00 0xAB 0x10 0x00 0xB3 0x52 0x02
			0x00 0x00 0x64 0x12 0xC2 0x24 0x00 0x00
			0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xA1>;
		qcom,config_profile_data1 = /bits/ 8 <
			0x46 0x00 0x00 0x00 0x00 0x00 0x00 0x00
			0xA3 0xBE 0xBC 0xC2 0xAC 0xA3 0xD6 0xC3
			0xB2 0xF6 0xD2 0x9C 0x81 0x61 0x51 0x44
			0x3A 0x32 0x29 0x98 0x94 0xDF 0xD1 0xFF
			0xDB 0xD4 0xD7 0xD6 0xD2 0xD1 0xCE 0xCA
			0xC4 0xC3 0xD0 0xBE 0x9A 0x8F 0x84 0x75
			0x65 0x62 0x7C 0x8C 0x9D 0xA7 0x6F 0x62
			0x20 0x00 0xAB 0x10 0x00 0xB3 0x52 0x02
			0x00 0x00 0x64 0x12 0xC2 0x24 0x00 0x00
			0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xA1>;

		lw_pd {
			qcom,cw_switch_config_profile;
			oplus,batt_num = <1>;
			qcom,cw_ui_full = <100>;
			qcom,cw_user_rsense = <5000>;
			qcom,design_capacity = <6500>;
			qcom,rated_capacity = <6500>;
			batid_voltage_range = <70 180>;
			qcom,config_profile_data0 = /bits/ 8 <
				0x46 0x00 0x00 0x00 0x00 0x00 0x00 0x00
				0xAD 0xB2 0xB4 0xBC 0xA4 0x9F 0xDD 0xC7
				0xB4 0xFF 0xE0 0xA0 0x83 0x6A 0x58 0x4E
				0x49 0x48 0x47 0xBF 0xA9 0xDF 0xAA 0xFA
				0xD5 0xD3 0xD9 0xD6 0xD2 0xD1 0xCF 0xCA
				0xC5 0xC5 0xCC 0xC2 0x99 0x8F 0x82 0x73
				0x63 0x60 0x6F 0x8B 0xA0 0x9C 0x88 0x62
				0x20 0x00 0xAB 0x10 0x00 0xB2 0xBF 0x02
				0x00 0x00 0x64 0x16 0xC1 0xA9 0x00 0x00
				0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x80>;
			qcom,config_profile_data1 = /bits/ 8 <
				0x46 0x00 0x00 0x00 0x00 0x00 0x00 0x00
				0xAD 0xB2 0xB4 0xBC 0xA4 0x9F 0xDD 0xC7
				0xB4 0xFF 0xE0 0xA0 0x83 0x6A 0x58 0x4E
				0x49 0x48 0x47 0xBF 0xA9 0xDF 0xAA 0xFA
				0xD5 0xD3 0xD9 0xD6 0xD2 0xD1 0xCF 0xCA
				0xC5 0xC5 0xCC 0xC2 0x99 0x8F 0x82 0x73
				0x63 0x60 0x6F 0x8B 0xA0 0x9C 0x88 0x62
				0x20 0x00 0xAB 0x10 0x00 0xB2 0xBF 0x02
				0x00 0x00 0x64 0x16 0xC1 0xA9 0x00 0x00
				0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x80>;
		};
		lw_hiz {
			qcom,cw_switch_config_profile;
			oplus,batt_num = <1>;
			qcom,cw_ui_full = <100>;
			qcom,cw_user_rsense = <5000>;
			qcom,design_capacity = <6100>;
			qcom,rated_capacity = <6100>;
			batid_voltage_range = <70 180>;
			qcom,config_profile_data0 = /bits/ 8 <
				0x46 0x00 0x00 0x00 0x00 0x00 0x00 0x00
				0xA3 0xBE 0xBC 0xC2 0xAC 0xA3 0xD6 0xC3
				0xB2 0xF6 0xD2 0x9C 0x81 0x61 0x51 0x44
				0x3A 0x32 0x29 0x98 0x94 0xDF 0xD1 0xFF
				0xDB 0xD4 0xD7 0xD6 0xD2 0xD1 0xCE 0xCA
				0xC4 0xC3 0xD0 0xBE 0x9A 0x8F 0x84 0x75
				0x65 0x62 0x7C 0x8C 0x9D 0xA7 0x6F 0x62
				0x20 0x00 0xAB 0x10 0x00 0xB3 0x52 0x02
				0x00 0x00 0x64 0x12 0xC2 0x24 0x00 0x00
				0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xA1>;
			qcom,config_profile_data1 = /bits/ 8 <
				0x46 0x00 0x00 0x00 0x00 0x00 0x00 0x00
				0xA3 0xBE 0xBC 0xC2 0xAC 0xA3 0xD6 0xC3
				0xB2 0xF6 0xD2 0x9C 0x81 0x61 0x51 0x44
				0x3A 0x32 0x29 0x98 0x94 0xDF 0xD1 0xFF
				0xDB 0xD4 0xD7 0xD6 0xD2 0xD1 0xCE 0xCA
				0xC4 0xC3 0xD0 0xBE 0x9A 0x8F 0x84 0x75
				0x65 0x62 0x7C 0x8C 0x9D 0xA7 0x6F 0x62
				0x20 0x00 0xAB 0x10 0x00 0xB3 0x52 0x02
				0x00 0x00 0x64 0x12 0xC2 0x24 0x00 0x00
				0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xA1>;
		};
	};

	rt1711h@4e {
		compatible = "richtek,rt1715";
		reg = <0x4e>;
		status = "okay";
		tcpc-dual,supported_modes = <0>; /* 0: dfp/ufp, */
						 /* 1: dfp, 2: ufp */
		rt-tcpc,name = "type_c_port0"; /* tcpc_device's name */
		rt-tcpc,role_def = <1>; /* 0: Unknown, 1: SNK, 2: SRC */
					/* 3: DRP, 4: Try.SRC, 5: Try.SNK */
		rt-tcpc,rp_level = <0>; /* 0: Default, 1: 1.5, 2: 3.0 */
		rt1711pd,intr_gpio = <&tlmm 89 0x0>;
		rt1711pd,intr_gpio_num = <89>;
		rt,disable_irq_reset;
		charger = <&oplus_sgm41515d>;
		pinctrl-names = "default";
		pinctrl-0 = <&rt1711h_int_n>;
		pd-data {
			pd,vid = <0x29cf>;
			pd,pid = <0x1711>;
			pd,source-cap-ext = /bits/ 8 <0xcf 0x29 0x11 0x17
						      0x00 0x00 0x00 0x00
						      0x00 0x00 0x00 0x00
						      0x00 0x00 0x00 0x00
						      0x00 0x00 0x00 0x00
						      0x00 0x00 0x01 0x02
						      0x00>;
			pd,sink-cap-ext = /bits/ 8 <0xcf 0x29 0x11 0x17
					0x00 0x00 0x00 0x00
					0x01 0x00 0x00 0x00
					0x00 0x00 0x00 0x00
					0x01 0x00 0x00 0x00
					0x00 0x00 0x00 0x00>;
			pd,mfrs = "RichtekTCPC";

			/*
			 *	VSAFE5V = 0, MAX_POWER = 1, CUSTOM = 2,
			 *	MAX_POWER_LV = 0x21, MAX_POWER_LVIC = 0x31
			 *	MAX_POWER_HV = 0x41, MAX_POWER_HVIC = 0x51
			 */
			pd,charging_policy = <0>;

			/*
			 * Fixed 5V, 500 mA <0x00019032>
			 * Fixed 5V, 1A <0x00019064>
			 * Fixed 5V, 2A <0x000190c8>
			 * Fixed 5V, 3A <0x0001912c>
			 * Fixed 9V, 500 mA <0x0002d032>
			 * Fixed 9V, 1A <0x0002d064>
			 * Fixed 9V, 2A <0x0002d0c8>
			 * Fixed 9V, 3A <0x0002d12c>
			 * Variable 5-9V, 1A <0x8642d064>
			 * Variable 5-9V, 2A <0x8642d0c8>
			 * Variable 5-9V, 3A <0x8642d12c>
			 */
			pd,source-pdo-size = <1>;
			pd,source-pdo-data = <0x00019064>;
			pd,sink-pdo-size = <1>;
			pd,sink-pdo-data = <0x0001912c>;

			pd,id-vdo-size = <6>;
			pd,id-vdo-data = <0xd14029cf 0x0 0x17110000
					  0x61000000 0x0 0x41000000>;

			bat,nr = <1>;
			pd,country_nr = <0>;

			bat-info0 {
				bat,vid = <0x29cf>;
				bat,pid = <0x1711>;
				bat,mfrs = "bat1";
				bat,design_cap = <3000>;
			};
		};
		dpm_caps {
			local_dr_power;
			local_dr_data;
			local_usb_comm;
			local_no_suspend;
			attempt_discover_cable;
			attempt_discover_id;
			attempt_discover_svid;

			/* 0: disable, 1: prefer_snk, 2: prefer_src */
			pr_check = <0>;
			/* 0: disable, 1: prefer_ufp, 2: prefer_dfp */
			dr_check = <0>;
		};
		displayport {
			/* connection type = "both", "ufp_d", "dfp_d" */
			1st_connection = "dfp_d";
			2nd_connection = "dfp_d";
			signal,dp_v13;
			typec,receptacle;
			dfp_d {
				pin_assignment,mode_c;
				pin_assignment,mode_d;
				pin_assignment,mode_e;
			};
		};
	};
};

/* load vibrator for rm pmic */
&soc {
	qcom,vibrator@5700 {
		compatible = "qcom,qpnp-vibrator-ldo";
		reg = <0x5700 0x100>;
		qcom,vib-ldo-volt-uv = <3000000>;
		qcom,disable-overdrive;
		qcom,vib-type = <1>;	/* 0:ldo 1:gpio */
		status = "okay";
		qcom,vibrator_switch-gpio = <&tlmm 100 0x00>;
		pinctrl-names = "vib_on_high", "vib_off_low";
		pinctrl-0 = <&vib_on_high>;
		pinctrl-1 = <&vib_off_low >;
	};
};

&qupv3_se0_i2c {
	status = "okay";
	pinctrl-0 = <&qupv3_se0_i2c_active>;
	pinctrl-1 = <&qupv3_se0_i2c_sleep>;
	qcom,clk-freq-out = <400000>;
	oplus,i2c-auto-suspend-delay-ms = <3000>;
	oplus_sgm41515d:oplus-sgm41515d@1a {
		status = "okay";
		compatible = "oplus,sgm41515-charger";
		reg = <0x1a>;
		dpdm-supply = <&usb2_phy0>;
		oplus,dischg-gpio = <&pm6125_gpios 8 0x00>;
		oplus,event-gpio = <&tlmm 32 0x00>;
		qcom,ntc-switch-gpio-amux = <&tlmm 101 0x00>;
		pinctrl-names = "event_default", "charging_inter_sleep",
					"dischg_enable", "dischg_disable";
		pinctrl-0 = <&charging_inter_active>;
		pinctrl-1 = <&charging_inter_sleep>;
		pinctrl-2 = <&dischg_enable>;
		pinctrl-3 = <&dischg_disable>;
		oplus,not_support_usb_btb;
		oplus,ic_index = <0>;
		oplus,ic_type = <OPLUS_CHG_IC_BUCK>;
		io-channels = <&pm6125_vadc ADC5_GPIO3_100K_PU>;
		io-channel-names = "chg_temp_adc";
		#include "BB4_ntc.h.dtsi"
	};

};

&soc {
	oplus_battery_log: oplus,battery_log {
		compatible = "oplus,battery_log";
		oplus,battery_log_support;
	};
	oplus_chg_core {
		oplus,chg_framework_v2;
		oplus,smart_charging_screenoff;
		oplus,chg_spec_version = <OPLUS_CHG_SPEC_VER_V3P7>;
		oplus,battery_type_by_cmdline;
		oplus-charger {
			sgm41515d_groups: oplus,sgm41515d-groups {
				functions = <
					OPLUS_IC_FUNC_INIT
					OPLUS_IC_FUNC_EXIT
					OPLUS_IC_FUNC_REG_DUMP
					OPLUS_IC_FUNC_SMT_TEST
