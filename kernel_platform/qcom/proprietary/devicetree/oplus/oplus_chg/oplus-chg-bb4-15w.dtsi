					OPLUS_IC_VIRQ_DATA_ROLE_CHANGED
					OPLUS_IC_VIRQ_PR_SWAP
				>;
			};
		};
		oplus-gauge {
			cw2217_groups: oplus,cw2217_groups {
				functions = <
					OPLUS_IC_FUNC_INIT
					OPLUS_IC_FUNC_EXIT
					OPLUS_IC_FUNC_REG_DUMP
					OPLUS_IC_FUNC_GAUGE_GET_BATT_VOL
