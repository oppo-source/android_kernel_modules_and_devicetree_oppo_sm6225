//khaje-camera-sensor-qrd.dtsi

&soc {
    cam_iovdd_gpio_49_regulator:cam_iovdd_fixed_regulator {
        compatible = "regulator-fixed";
        regulator-name = "cam_iovdd_gpio_49_regulator";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        enable-active-high;
        gpio = <&tlmm 49 0>;
        pinctrl-names = "cam_default","cam_suspend";
        pinctrl-0 = <&cam_sensor_iovdd_active>;
        pinctrl-1 = <&cam_sensor_iovdd_suspend>;
    };
    cam_avdd_gpio_31_regulator:cam_avdd31_fixed_regulator {
        compatible = "regulator-fixed";
        regulator-name = "cam_avdd_gpio_31_regulator";
        regulator-min-microvolt = <2800000>;
        regulator-max-microvolt = <2800000>;
        enable-active-high;
        gpio = <&tlmm 31 0>;
        pinctrl-names = "cam_default","cam_suspend";
        pinctrl-0 = <&cam_sensor_avdd_active>;
        pinctrl-1 = <&cam_sensor_avdd_suspend>;
    };
    cam_avdd_gpio_25_regulator:cam_avdd25_fixed_regulator {
        compatible = "regulator-fixed";
        regulator-name = "cam_avdd_gpio_25_regulator";
        regulator-min-microvolt = <2800000>;
        regulator-max-microvolt = <2800000>;
        enable-active-high;
        gpio = <&tlmm 25 0>;
        pinctrl-names = "cam_default","cam_suspend";
        pinctrl-0 = <&cam_sensor_avdd2_active>;
        pinctrl-1 = <&cam_sensor_avdd2_suspend>;
    };
    cam_avdd_gpio_28_regulator:cam_avdd28_fixed_regulator {
        compatible = "regulator-fixed";
        regulator-name = "cam_avdd_gpio_28_regulator";
        regulator-min-microvolt = <2800000>;
        regulator-max-microvolt = <2800000>;
        enable-active-high;
        gpio = <&tlmm 28 0>;
        pinctrl-names = "cam_default","cam_suspend";
        pinctrl-0 = <&cam_sensor_avdd3_active>;
        pinctrl-1 = <&cam_sensor_avdd3_suspend>;
    };
    cam_dvdd_gpio_67_regulator:cam_dvdd67_fixed_regulator {
        compatible = "regulator-fixed";
        regulator-name = "cam_avdd_gpio_67_regulator";
        regulator-min-microvolt = <1200000>;
        regulator-max-microvolt = <1200000>;
        enable-active-high;
        gpio = <&tlmm 67 0>;
        pinctrl-names = "cam_default","cam_suspend";
        pinctrl-0 = <&cam_sensor_dvdd_active>;
        pinctrl-1 = <&cam_sensor_dvdd_suspend>;
    };
    cam_dvdd_gpio_102_regulator:cam_dvdd102_fixed_regulator {
        compatible = "regulator-fixed";
        regulator-name = "cam_avdd_gpio_102_regulator";
        regulator-min-microvolt = <1200000>;
        regulator-max-microvolt = <1200000>;
        enable-active-high;
        gpio = <&tlmm 102 0>;
        pinctrl-names = "cam_default","cam_suspend";
        pinctrl-0 = <&cam_sensor_dvdd2_active>;
        pinctrl-1 = <&cam_sensor_dvdd2_suspend>;
    };
};

&tlmm {

    cam_sensor_iovdd_active: cam_sensor_iovdd_active {
        mux {
            pins = "gpio49";
            function = "gpio";
        };
        config {
            pins = "gpio49";
            bias-disable; /* No PULL */
            drive-strength = <2>; /* 2 MA */
        };
    };
    cam_sensor_iovdd_suspend: cam_sensor_iovdd_suspend {
        mux {
            pins = "gpio49";
            function = "gpio";
        };
        config {
            pins = "gpio49";
            bias-pull-down; /* PULL DOWN */
            drive-strength = <2>; /* 2 MA */
            output-low;
        };
    };
    cam_sensor_avdd_active: cam_sensor_avdd_active {
        mux {
            pins = "gpio31";
            function = "gpio";
        };
        config {
            pins = "gpio31";
            bias-disable; /* No PULL */
            drive-strength = <2>; /* 2 MA */
        };
    };
    cam_sensor_avdd_suspend: cam_sensor_avdd_suspend {
        mux {
            pins = "gpio31";
            function = "gpio";
        };
        config {
            pins = "gpio31";
            bias-pull-down; /* PULL DOWN */
            drive-strength = <2>; /* 2 MA */
            output-low;
        };
    };
    cam_sensor_avdd2_active: cam_sensor_avdd2_active {
        mux {
            pins = "gpio25";
            function = "gpio";
        };
        config {
            pins = "gpio25";
            bias-disable; /* No PULL */
            drive-strength = <2>; /* 2 MA */
        };
    };
    cam_sensor_avdd2_suspend: cam_sensor_avdd2_suspend {
        mux {
            pins = "gpio25";
            function = "gpio";
        };
        config {
            pins = "gpio25";
            bias-pull-down; /* PULL DOWN */
            drive-strength = <2>; /* 2 MA */
            output-low;
        };
    };
    cam_sensor_avdd3_active: cam_sensor_avdd3_active {
        mux {
            pins = "gpio28";
            function = "gpio";
        };
        config {
            pins = "gpio28";
            bias-disable; /* No PULL */
            drive-strength = <2>; /* 2 MA */
        };
    };
    cam_sensor_avdd3_suspend: cam_sensor_avdd3_suspend {
        mux {
            pins = "gpio28";
            function = "gpio";
        };
        config {
            pins = "gpio28";
            bias-pull-down; /* PULL DOWN */
            drive-strength = <2>; /* 2 MA */
            output-low;
        };
    };
    cam_sensor_dvdd_active: cam_sensor_dvdd_active {
        mux {
            pins = "gpio67";
            function = "gpio";
        };
        config {
            pins = "gpio67";
            bias-disable; /* No PULL */
            drive-strength = <2>; /* 2 MA */
        };
    };
    cam_sensor_dvdd_suspend: cam_sensor_dvdd_suspend {
        mux {
            pins = "gpio67";
            function = "gpio";
        };
        config {
            pins = "gpio67";
            bias-pull-down; /* PULL DOWN */
            drive-strength = <2>; /* 2 MA */
            output-low;
        };
    };
    cam_sensor_dvdd2_active: cam_sensor_dvdd2_active {
        mux {
            pins = "gpio102";
            function = "gpio";
        };
        config {
            pins = "gpio102";
            bias-disable; /* No PULL */
            drive-strength = <2>; /* 2 MA */
        };
    };
    cam_sensor_dvdd2_suspend: cam_sensor_dvdd2_suspend {
        mux {
            pins = "gpio102";
            function = "gpio";
        };
        config {
            pins = "gpio102";
            bias-pull-down; /* PULL DOWN */
            drive-strength = <2>; /* 2 MA */
            output-low;
        };
    };
    cam_sensor_mono_reset_active: cam_sensor_mono_reset_active {
        mux {
            pins = "gpio18";
            function = "gpio";
        };
        config {
            pins = "gpio18";
            bias-disable; /* No PULL */
            drive-strength = <2>; /* 2 MA */
        };
    };
    cam_sensor_mono_reset_suspend: cam_sensor_mono_reset_suspend {
        mux {
            pins = "gpio18";
            function = "gpio";
        };
        config {
            pins = "gpio18";
            bias-pull-down; /* PULL DOWN */
            drive-strength = <2>; /* 2 MA */
            output-low;
        };
    };

    cam_sensor_wide_reset_active: cam_sensor_wide_reset_active {
        mux {
            pins = "gpio24";
            function = "gpio";
        };
        config {
            pins = "gpio24";
            bias-disable; /* No PULL */
            drive-strength = <2>; /* 2 MA */
        };
    };
    cam_sensor_wide_reset_suspend: cam_sensor_wide_reset_suspend {
        mux {
            pins = "gpio24";
            function = "gpio";
        };
        config {
            pins = "gpio24";
            bias-pull-down; /* PULL DOWN */
            drive-strength = <2>; /* 2 MA */
            output-low;
        };
    };
    cam_sensor_mipi_switch_active: cam_sensor_mipi_switch_active {
        mux {
            pins = "gpio99";
            function = "gpio";
        };
        config {
            pins = "gpio99";
            bias-disable; /* No PULL */
            drive-strength = <2>; /* 2 MA */
        };
    };
    cam_sensor_mipi_switch_suspend: cam_sensor_mipi_switch_suspend {
        mux {
            pins = "gpio99";
            function = "gpio";
        };
        config {
            pins = "gpio99";
            bias-pull-down; /* PULL DOWN */
            drive-strength = <2>; /* 2 MA */
            output-low;
        };
    };
    cam_sensor_active_ponv: cam_sensor_active_ponv {
        /* ponv */
        mux {
            pins = "gpio86";
            function = "gpio";
        };

        config {
            pins = "gpio86";
            bias-disable;  /* NO PULL */
            drive-strength = <2>; /* 2 MA */
            /*output-high;*/
        };
    };

    cam_sensor_suspend_ponv: cam_sensor_suspend_ponv {
        /* PONV */
        mux {
            pins = "gpio86";
            function = "gpio";
        };

        config {
            pins = "gpio86";
            bias-pull-down; /* PULL DOWN */
            drive-strength = <2>; /* 2 MA */
            output-low;
        };
    };
    flash_en_default: flash_en_default {
         mux {
             pins = "gpio111";
             function = "gpio";
         };
         config {
             pins = "gpio111";
             drive-strength = <2>;
             bias-disable; /* No PULL */
         };
     };
     flash_en_suspend: flash_en_suspend {
         mux {
             pins = "gpio111";
             function = "gpio";
         };
         config {
             pins = "gpio111";
             drive-strength = <2>;
             bias-pull-down;
             output-low;
         };
     };
     flash_torch_en_default: flash_torch_en_default {
         mux {
             pins = "gpio86";
             function = "gpio";
         };
         config {
             pins = "gpio86";
             bias-disable; /* No PULL */
             drive-strength = <2>;
         };
     };
     flash_torch_en_suspend: flash_torch_en_suspend {
         mux {
             pins = "gpio86";
             function = "gpio";
         };
         config {
             pins = "gpio86";
             drive-strength = <2>;
             bias-pull-down;
             output-low;
         };
     };
     gpio_pwm_default: gpio_pwm_default {
         mux {
             pins = "gpio86";
             function = "GCC_GP1";
         };

         config {
             pins = "gpio86";
             bias-disable; /* No PULL */
             drive-strength = <2>;
         };
     };
     gpio_pwm_suspend: gpio_pwm_suspend {
         mux {
             pins = "gpio86";
             function = "GCC_GP1";
         };

         config {
             pins = "gpio86";
             drive-strength = <2>;
             bias-pull-down;
             output-low;
         };
     };
};

&cam_sensor_mclk0_active {
    /* MCLK 0*/
    mux {
        pins = "gpio20";
        function = "cam_mclk";
    };

    config {
        pins = "gpio20";
        bias-disable; /* No PULL */
        drive-strength = <6>; /* 2 MA */
    };
};

&cam_sensor_mclk0_suspend {
    /* MCLK 0*/
    mux {
        pins = "gpio20";
        function = "cam_mclk";
    };

    config {
        pins = "gpio20";
        bias-pull-down; /* PULL DOWN */
        drive-strength = <6>; /* 2 MA */
    };
};

&cam_sensor_rear0_reset_active {
    mux {
        pins = "gpio65";
        function = "gpio";
    };
    config {
        pins = "gpio65";
        bias-disable; /* No PULL */
        drive-strength = <2>; /* 2 MA */
    };
};

