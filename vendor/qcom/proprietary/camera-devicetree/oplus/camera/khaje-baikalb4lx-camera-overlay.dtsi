&eeprom_rear {
        qcom,eeprom-name = "rear_eeprom";
        cam_vio-supply = <&L9A>;
        cam_clk-supply = <&gcc_camss_top_gdsc>;
        cam_vana-supply = <&cam_avdd_gpio_25_regulator>;
        cam_vdig-supply = <&cam_dvdd_gpio_67_regulator>;
        regulator-names = "cam_vio","cam_clk","cam_vana","cam_vdig";
        rgltr-cntrl-support;
        pwm-switch;
        rgltr-min-voltage = <1800000 0 2800000 1200000>;
        rgltr-max-voltage = <1800000 0 2800000 1200000>;
        rgltr-load-current = <120000 0 120000 120000>;
        gpio-no-mux = <0>;
        pinctrl-names = "cam_default", "cam_suspend";
        pinctrl-0 = <&cam_sensor_mclk0_active
                     &cam_sensor_rear0_reset_active>;
        pinctrl-1 = <&cam_sensor_mclk0_suspend
                     &cam_sensor_rear0_reset_suspend>;
        gpios = <&tlmm 20 0>,
                <&tlmm 65 0>;
        gpio-reset = <1>;
        gpio-req-tbl-num = <0 1>;
        gpio-req-tbl-flags = <1 0>;
        gpio-req-tbl-label = "CAMIF_MCLK0",
                             "CAM_RESET0";
        sensor-mode = <0>;
        cci-master = <0>;
        status = "ok";
        clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
        clock-names = "cam_clk";
        clock-cntl-level = "turbo";
        clock-rates = <24000000>;
};

&eeprom_front {
        qcom,eeprom-name = "front_eeprom";
        cam_vio-supply = <&L9A>;
        cam_clk-supply = <&gcc_camss_top_gdsc>;
        cam_vana-supply = <&cam_avdd_gpio_25_regulator>;
        cam_vdig-supply = <&cam_dvdd_gpio_67_regulator>;
        regulator-names = "cam_vio","cam_clk","cam_vana","cam_vdig";
        rgltr-cntrl-support;
        pwm-switch;
        rgltr-min-voltage = <1800000 0 2800000 1200000>;
        rgltr-max-voltage = <1800000 0 2800000 1200000>;
        rgltr-load-current = <120000 0 120000 120000>;
        gpio-no-mux = <0>;
        pinctrl-names = "cam_default", "cam_suspend";
        pinctrl-0 = <&cam_sensor_mclk2_active
                     &cam_sensor_front0_reset_active>;
        pinctrl-1 = <&cam_sensor_mclk2_suspend
                     &cam_sensor_front0_reset_suspend>;
        gpios = <&tlmm 21 0>,
                <&tlmm 19 0>;
        gpio-reset = <1>;
        gpio-req-tbl-num = <0 1>;
        gpio-req-tbl-flags = <1 0>;
        gpio-req-tbl-label = "CAMIF_MCLK1",
                                "CAM_RESET1";
        cci-master = <1>;
        clocks = <&gcc GCC_CAMSS_MCLK1_CLK>;
        clock-rates = <24000000>;
};

&eeprom_rear_aux {
        slave-addr = <0x80>;
        eeprom-name = "msm_eeprom";
        i2c-freq-mode = <1>;
        cam_vio-supply = <&L9A>;
        cam_clk-supply = <&gcc_camss_top_gdsc>;
        cam_vana-supply = <&cam_avdd_gpio_25_regulator>;
        regulator-names = "cam_vio","cam_clk","cam_vana";
        rgltr-cntrl-support;
        pwm-switch;
        rgltr-min-voltage = <1800000 0 2800000>;
        rgltr-max-voltage = <1800000 0 2800000>;
        rgltr-load-current = <120000 0 120000>;
        gpio-no-mux = <0>;
        pinctrl-names = "cam_default", "cam_suspend";
        qcom,cam-power-seq-type = "cam_vio", "cam_vana", "cam_clk";
        qcom,cam-power-seq-cfg-val = <1 1 24000000>;
        qcom,cam-power-seq-delay = <1 1 5>;
        pinctrl-0 = <&cam_sensor_mclk1_active
                     &cam_sensor_mono_reset_active>;
        pinctrl-1 = <&cam_sensor_mclk1_suspend
                     &cam_sensor_mono_reset_suspend>;
        gpios = <&tlmm 27 0>,
                <&tlmm 18 0>;
        gpio-reset = <1>;
        gpio-req-tbl-num = <0 1>;
        gpio-req-tbl-flags = <1 0>;
        gpio-req-tbl-label = "CAMIF_MCLK2",
                                "CAM_RESET2";
        sensor-mode = <0>;
        cci-master = <1>;
        status = "ok";
        clocks = <&gcc GCC_CAMSS_MCLK2_CLK>;
        clock-names = "cam_clk";
        clock-cntl-level = "turbo";
        clock-rates = <24000000>;
};

&eeprom_rear_aux2 {
    slave-addr = <0x6C>;
    eeprom-name = "msm_eeprom";
    i2c-freq-mode = <1>;
    cam_vio-supply = <&L9A>;
    cam_clk-supply = <&gcc_camss_top_gdsc>;
    cam_vana-supply = <&cam_avdd_gpio_25_regulator>;
    regulator-names = "cam_vio","cam_clk","cam_vana";
    rgltr-cntrl-support;
    pwm-switch;
    rgltr-min-voltage = <1800000 0 2800000>;
    rgltr-max-voltage = <1800000 0 2800000>;
    rgltr-load-current = <120000 0 120000>;
    gpio-no-mux = <0>;
    pinctrl-names = "cam_default", "cam_suspend";
    qcom,cam-power-seq-type = "cam_reset", "cam_vio", "cam_vana", "cam_reset", "cam_clk";
    qcom,cam-power-seq-cfg-val = <0 1 1 1 24000000>;
    qcom,cam-power-seq-delay = <1 1 1 1 5>;
    pinctrl-0 = <&cam_sensor_mclk1_active
                 &cam_sensor_mono_reset_active>;
    pinctrl-1 = <&cam_sensor_mclk1_suspend
                 &cam_sensor_mono_reset_suspend>;
    gpios = <&tlmm 27 0>,
            <&tlmm 18 0>;
    gpio-reset = <1>;
    gpio-req-tbl-num = <0 1>;
    gpio-req-tbl-flags = <1 0>;
    gpio-req-tbl-label = "CAMIF_MCLK2",
                            "CAM_RESET2";
    sensor-mode = <0>;
    cci-master = <1>;
    status = "ok";
    clocks = <&gcc GCC_CAMSS_MCLK2_CLK>;
    clock-names = "cam_clk";
    clock-cntl-level = "turbo";
    clock-rates = <24000000>;
};

&actuator_rear {
    status = "disable";
};

&soc {
        led_gpio_flash_rear: qcom,camera-flash@0 {
                cell-index = <0>;
                compatible = "qcom,camera-flash";
                flash-type = <CAM_FLASH_TYPE_GPIO>;
                gpio-no-mux = <0>;
                flash-name = "sgm3785";
                pinctrl-names = "cam_default", "cam_suspend","pwm_default","pwm_suspend";
                pinctrl-0 = <&flash_en_default &flash_torch_en_default>;
                pinctrl-1 = <&flash_en_suspend &flash_torch_en_suspend>;
                pinctrl-2 = <&gpio_pwm_default>;
                pinctrl-3 = <&gpio_pwm_suspend>;
                gpios = <&tlmm 111 0>,
                        <&tlmm 86 0>;
                gpio-custom1 = <0>;
                gpio-custom2 = <1>;
                gpio-req-tbl-num = <0 1>;
                gpio-req-tbl-flags = <0 0>;
                gpio-req-tbl-label = "CUSTOM_GPIO1","CUSTOM_GPIO2";
                flash-current = <1075>;
                torch-current = <160>;
                clocks = <&gcc GCC_GP1_CLK>;
                clock-names = "gpio-pwm-clk";
                clock-cntl-level = "turbo";
                clock-rates = <48000>;
                status = "ok";
        };
};

&cam_cci0 {
        actuator_rear_af: qcom,actuatoraf0 {
                cell-index = <0>;
                compatible = "qcom,actuator";
                cci-master = <0>;
                cam_vaf-supply = <&cam_avdd_gpio_28_regulator>;
                regulator-names = "cam_vaf";
                rgltr-cntrl-support;
                rgltr-min-voltage = <2800000>;
                rgltr-max-voltage = <2800000>;
                rgltr-load-current = <100000>;
                status = "ok";
        };
};

&pm8008_8 {
	status = "disabled";
};

&led_flash_rear {
	status = "disabled";
};

&led_flash_rear_aux{
    status = "disabled";
};
&led_flash_rear_aux2{
    status = "disabled";
};
&camera_rear {
        cell-index = <0>;
        compatible = "qcom,cam-sensor";
        csiphy-sd-index = <1>;
        sensor-position-roll = <90>;
        sensor-position-pitch = <0>;
        sensor-position-yaw = <180>;
        actuator-src = <&actuator_rear_af>;
        led-flash-src = <&led_gpio_flash_rear>;
        eeprom-src = <&eeprom_rear>;
        cam_vio-supply = <&L9A>;
        cam_clk-supply = <&gcc_camss_top_gdsc>;
        cam_vana-supply = <&cam_avdd_gpio_25_regulator>;
        cam_vdig-supply = <&cam_dvdd_gpio_67_regulator>;
        regulator-names = "cam_vio","cam_clk","cam_vana","cam_vdig";
        rgltr-cntrl-support;
        pwm-switch;
        rgltr-min-voltage = <1800000 0 2800000 1200000>;
        rgltr-max-voltage = <1800000 0 2800000 1200000>;
        rgltr-load-current = <120000 0 120000 120000>;
        gpio-no-mux = <0>;
        pinctrl-names = "cam_default", "cam_suspend";
        pinctrl-0 = <&cam_sensor_mclk0_active
                     &cam_sensor_rear0_reset_active>;
        pinctrl-1 = <&cam_sensor_mclk0_suspend
                     &cam_sensor_rear0_reset_suspend>;
        gpios = <&tlmm 20 0>,
                <&tlmm 65 0>;
        gpio-reset = <1>;
        gpio-req-tbl-num = <0 1>;
        gpio-req-tbl-flags = <1 0>;
        gpio-req-tbl-label = "CAMIF_MCLK0",
                             "CAM_RESET0";
        sensor-mode = <0>;
        cci-master = <0>;
        status = "ok";
        clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
        clock-names = "cam_clk";
        clock-cntl-level = "turbo";
        clock-rates = <24000000>;
};

&camera_front {
        cell-index = <1>;
        compatible = "qcom,cam-sensor";
        csiphy-sd-index = <2>;
        sensor-position-roll = <270>;
        sensor-position-pitch = <0>;
        sensor-position-yaw = <0>;
        eeprom-src = <&eeprom_front>;
        cam_vio-supply = <&L9A>;
        cam_clk-supply = <&gcc_camss_top_gdsc>;
        cam_vana-supply = <&cam_avdd_gpio_25_regulator>;
        cam_vdig-supply = <&cam_dvdd_gpio_67_regulator>;
        regulator-names = "cam_vio","cam_clk","cam_vana","cam_vdig";
        rgltr-cntrl-support;
        pwm-switch;
        rgltr-min-voltage = <1800000 0 2800000 1200000>;
        rgltr-max-voltage = <1800000 0 2800000 1200000>;
        rgltr-load-current = <120000 0 120000 120000>;
        gpio-no-mux = <0>;
        pinctrl-names = "cam_default", "cam_suspend";
        pinctrl-0 = <&cam_sensor_mclk2_active
                     &cam_sensor_front0_reset_active>;
        pinctrl-1 = <&cam_sensor_mclk2_suspend
                     &cam_sensor_front0_reset_suspend>;
        gpios = <&tlmm 21 0>,
                <&tlmm 19 0>;
        gpio-reset = <1>;
        gpio-req-tbl-num = <0 1>;
        gpio-req-tbl-flags = <1 0>;
        gpio-req-tbl-label = "CAMIF_MCLK1",
                                "CAM_RESET1";
        sensor-mode = <0>;
        cci-master = <1>;
        status = "ok";
        clocks = <&gcc GCC_CAMSS_MCLK1_CLK>;
        clock-names = "cam_clk";
        clock-cntl-level = "turbo";
        clock-rates = <24000000>;
};

