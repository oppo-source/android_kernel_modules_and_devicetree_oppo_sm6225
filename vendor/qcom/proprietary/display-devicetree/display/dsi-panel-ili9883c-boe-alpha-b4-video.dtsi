					15 01 00 00 00 00 02 8C E4
					15 01 00 00 00 00 02 8D E4
					15 01 00 00 00 00 02 8E E5
					15 01 00 00 00 00 02 8F E5
					15 01 00 00 00 00 02 90 E5
					15 01 00 00 00 00 02 91 E6
					15 01 00 00 00 00 02 92 E6
					15 01 00 00 00 00 02 93 E6
					15 01 00 00 00 00 02 94 E6
					15 01 00 00 00 00 02 95 E6
					15 01 00 00 00 00 02 A7 E6
					15 01 00 00 00 00 02 AD E6
					  /*11.5% MODE3*/
					15 01 00 00 00 00 02 B8 84
					15 01 00 00 00 00 02 96 60
					15 01 00 00 00 00 02 97 9B
					15 01 00 00 00 00 02 98 9C
					15 01 00 00 00 00 02 99 9F
					15 01 00 00 00 00 02 9A C6
					15 01 00 00 00 00 02 9B C9
					15 01 00 00 00 00 02 9C CE
					15 01 00 00 00 00 02 9D CE
					15 01 00 00 00 00 02 9E CF
					15 01 00 00 00 00 02 9F E1
					15 01 00 00 00 00 02 B5 D3
					15 01 00 00 00 00 02 A8 F0
					15 01 00 00 00 00 02 AE D9
					  /*cabc end*/
					39 01 00 00 00 00 04 FF 98 83 00
					15 01 00 00 00 00 02 53 2C            //enable pwm
					39 01 00 00 00 00 03 51 00 00
					15 01 00 00 00 00 02 55 01
					15 01 00 00 00 00 02 35 00
					39 01 00 00 00 00 03 68 03 00
					15 01 00 00 42 00 02 11 00
					15 01 00 00 1F 00 02 29 00
				];
				qcom,mdss-dsi-off-command = [
					39 01 00 00 05 00 04 FF 98 83 00
					15 01 00 00 14 00 02 28 00
					15 01 00 00 78 00 02 10 00
